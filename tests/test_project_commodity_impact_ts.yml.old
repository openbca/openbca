test_constant_join:
  model: openbca_impact.project_commodity_impact_ts
  inputs:
    openbca_impact.project_commodity_load_shape_ts:
        rows:
        - project_id: 1
          load_shape: LS
          commodity: ELECTRICITY
          utility: U1
          region: R1
          year: 2020
          quarter: 1
          month: 1
          hour_of_year: 1
          hour_of_day: 1
          normalized_load_shape_value: 1
          discount: 1
          net_energy_savings: 1
          net_energy_savings_ts: 1
    openbca_reference.avoided_costs_ts:
        columns:
          utility: str
          region: str
          commodity: str
          avoided_cost: str
          value: int
          year: int
          quarter: int
          month: int
          hour_of_year: int
          hour_of_day: int
        rows:
        - utility: U1
          region: R1
          commodity: ELECTRICITY
          avoided_cost: total
          value: 1
          year: null
          quarter: null
          month: null
          hour_of_year: null
          hour_of_day: null
  outputs:
    partial: true
    query:
      rows:
        - project_id: 1
          region: R1
          commodity: ELECTRICITY
          avoided_cost: total
          av_cost_value: 1
          impact_value: 1

